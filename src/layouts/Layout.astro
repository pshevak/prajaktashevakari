---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const { title = "Prajakta Shevakari — Portfolio" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#fbbf24" />
    <link rel="icon" href={`${base}assets/leaf-flame.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="sticky top-0 z-50" style="backdrop-filter: blur(8px); background: rgba(0,0,0,.3); border-bottom:1px solid #262626;">
      <div class="max-w-6xl mx-auto px-4 py-3" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
        <a href={`${base}`} style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
          <img src={`${base}assets/leaf-flame.svg`} alt="Logo" style="width:28px;height:28px;border-radius:9999px"/>
          <span style="font-weight:900;letter-spacing:.2px;font-size:20px">Prajakta</span>
        </a>
        <nav style="display:flex;gap:8px;align-items:center">
          <a class="btn-ghost btn" href={`${base}projects`}>Projects</a>
          <a class="btn-ghost btn" href={`${base}experience`}>Experience</a>
          <a class="btn-ghost btn" href={`${base}teaching`}>Teaching</a>
          <a class="btn-ghost btn" href={`${base}contact`}>Contact</a>
        </nav>
      </div>
    </div>
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="max-w-6xl mx-auto px-4 py-10" style="color:#a8a29e;font-size:14px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div>© 2025 Prajakta Shevakari — Astro + Tailwind • GitHub Pages</div>
      <div class="hidden md:block">Fast • Accessible • MD-powered</div>
    </footer>
  </body>
</html>
