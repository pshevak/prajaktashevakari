---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Teaching & Leadership — Prajakta Shevakari">
  <section>
    <h1 class="text-2xl font-extrabold tracking-tight mb-4">Teaching & Leadership</h1>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="card">
        <h3 class="font-bold">Head Course Assistant — Software System Design (Fall 2025)</h3>
        <p class="text-neutral-300">Led CA team ops, rubric enforcement, and student support; collaborated with faculty on specs and grading quality.</p>
      </div>
      <div class="card">
        <h3 class="font-bold">Course Assistant — Operating Systems (Spring 2025)</h3>
        <p class="text-neutral-300">Office hours, systems assignment grading, and coaching on VM/process/concurrency fundamentals.</p>
      </div>
    </div>
  </section>
</Layout>
