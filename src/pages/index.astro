---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Prajakta Shevakari — SWE & AI/ML">
  <section class="grid md:grid-cols-2 gap-6 items-start">
    <div class="space-y-3">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Prajakta Shevakari</h1>
      <p class="text-neutral-300">JHU MSE CS (Jun 2026) • Software Engineering & AI/ML • Open to U.S. relocation</p>
      <div class="flex flex-wrap gap-2">
        <span class="badge">6+ yrs industry (Barclays, JPMorgan, FIS)</span>
        <span class="badge">SWE • AI/ML • Data</span>
        <span class="badge">Python • Java • PyTorch • Transformers</span>
        <span class="badge">AWS • Spark • SQL • APIs</span>
        <span class="badge">Jun 2026 start</span>
      </div>
      <div class="flex gap-2 pt-2">
        <a class="btn btn-primary no-underline" href="/assets/resume.pdf" target="_blank" rel="noopener">Resume (PDF)</a>
        <a class="btn btn-ghost no-underline" href="mailto:prajaktashevakari@gmail.com">Email</a>
        <a class="btn btn-ghost no-underline" href="https://www.linkedin.com/in/prajaktashevakari/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost no-underline" href="https://github.com/pshevak" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="grid gap-3">
      <div class="card">
        <h3 class="font-bold">About</h3>
        <p class="text-neutral-300">I’m a Master’s student in <strong>Computer Science at Johns Hopkins University</strong> with <strong>six years of industry experience</strong> across Barclays, JPMorgan, and FIS Global. I bridge <strong>software engineering</strong> and <strong>applied AI/ML</strong>—building intelligent, scalable systems that deliver measurable impact.</p>
      </div>
      <div class="card grid md:grid-cols-3 gap-3">
        <div><div class="text-sm uppercase text-neutral-400">Recent Win</div><div class="font-semibold">DR deploy: <span class="text-brand-400">4h → &lt;10m</span></div></div>
        <div><div class="text-sm uppercase text-neutral-400">Impact</div><div class="font-semibold">MTTR ↓ <span class="text-brand-400">~70%</span></div></div>
        <div><div class="text-sm uppercase text-neutral-400">Delivery</div><div class="font-semibold"><span class="text-brand-400">90+</span> weekly releases</div></div>
      </div>
    </div>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-bold mb-3">Highlights</h2>
    <div class="grid md:grid-cols-3 gap-3">
      <div class="card">Reduced MTTR by <strong>~70%</strong> via resilient redesigns and debuggability.</div>
      <div class="card">Automated DR pipeline: <strong>4h → &lt;10m</strong> orchestration.</div>
      <div class="card">Delivered <strong>90+ weekly releases</strong> with ~95% on-time.</div>
    </div>
  </section>
</Layout>
