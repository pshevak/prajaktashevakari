---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Prajakta Shevakari — SWE & AI/ML">
  <section class="grid md:grid-cols-2 gap-6 items-start">
    <div class="space-y-3">
      <h1 style="font-weight:900;font-size:34px;letter-spacing:.2px">Prajakta Shevakari</h1>
      <p style="color:#cbd5e1">JHU MSE CS (Jun 2026) • Software Engineering & AI/ML • Open to U.S. relocation</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        <span class="badge">6+ yrs industry (Barclays, JPMorgan, FIS)</span>
        <span class="badge">SWE • AI/ML • Data</span>
        <span class="badge">Python • Java • PyTorch • Transformers</span>
        <span class="badge">AWS • Spark • SQL • APIs</span>
        <span class="badge">Jun 2026 start</span>
      </div>
      <div style="display:flex;gap:8px;padding-top:8px">
        <a class="btn btn-primary" href={`${base}assets/resume.pdf`} target="_blank" rel="noopener">Resume (PDF)</a>
        <a class="btn btn-ghost" href="mailto:prajaktashevakari@gmail.com">Email</a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/prajakta-shevakari/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href="https://github.com/pshevak" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="grid gap-3">
      <div class="card">
        <h3 style="font-weight:700">About</h3>
        <p style="color:#d1d5db">I’m a Master’s student in <strong>Computer Science at Johns Hopkins University</strong> with <strong>six years of industry experience</strong> across Barclays, JPMorgan, and FIS Global. I bridge <strong>software engineering</strong> and <strong>applied AI/ML</strong>—building intelligent, scalable systems that deliver measurable impact.</p>
      </div>
      <div class="card" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
        <div><div style="font-size:12px;color:#a3a3a3;text-transform:uppercase">Recent Win</div><div style="font-weight:700">DR deploy: <span style="color:#fbbf24">4h → &lt;10m</span></div></div>
        <div><div style="font-size:12px;color:#a3a3a3;text-transform:uppercase">Impact</div><div style="font-weight:700">MTTR ↓ <span style="color:#fbbf24">~70%</span></div></div>
        <div><div style="font-size:12px;color:#a3a3a3;text-transform:uppercase">Delivery</div><div style="font-weight:700"><span style="color:#fbbf24">90+</span> weekly releases</div></div>
      </div>
    </div>
  </section>

  <section style="margin-top:16px">
    <h2 style="font-weight:800;margin-bottom:10px;font-size:20px">Highlights</h2>
    <div style="display:grid;gap:12px;grid-template-columns:repeat(1,1fr)"></div>
    <div class="grid md:grid-cols-3 gap-3">
      <div class="card">Reduced MTTR by <strong>~70%</strong> via resilient redesigns and debuggability.</div>
      <div class="card">Automated DR pipeline: <strong>4h → &lt;10m</strong> orchestration.</div>
      <div class="card">Delivered <strong>90+ weekly releases</strong> with ~95% on-time.</div>
    </div>
  </section>
</Layout>
